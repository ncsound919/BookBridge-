    "indexing_strategy": {
      "chunk_size_tokens": 800,
      "chunk_overlap_tokens": 100,
      "preserve_section_headings": true,
      "ocr_fallback": {
        "enabled": true,
        "engine": "Tesseract 5",
        "trigger": "page_has_no_text_layer",
        "language_detection": "automatic",
        "note": "OCR is applied per-page. Pages with extractable text skip OCR. Applies to scanned PDFs."
      },
      "equation_extraction": {
        "enabled": true,
        "strategy": "detect LaTeX delimiters and MathML blocks in source; fall back to heuristic rendering for display-math regions in scanned pages"
      },
      "figure_table_extraction": {
        "enabled": true,
        "strategy": "detect caption patterns (Figure N, Table N) and associate with nearest bounding region"
      },
      "graph_construction": {
        "enabled": true,
        "strategy": "shared concept embedding clustering + explicit in-text citation pattern matching",
        "run_on": "post_index"
      },
      "reindex_triggers": [
        "drive_file_modified",
        "drive_change_watch_event",
        "missing_hash",
        "manual_reindex"
      ]
    }
  },

